# ===============================
# ❤️ LIKE / UNLIKE COMMENT
# ===============================
@reels_bp.route("/comment_like/<int:id>", methods=["POST"])
def comment_like(id):

    if "user_id" not in session:
        return jsonify({
            "ok": False,
            "error": "login required"
        })

    uid = session.get("user_id")

    conn = get_conn()
    c = conn.cursor()

    # ==========================================
    # CHECK COMMENT
    # ==========================================
    c.execute("""
        SELECT
            id,
            user_id,
            reel_id
        FROM reel_comments
        WHERE id=?
    """, (id,))

    comment = c.fetchone()

    if not comment:
        conn.close()

        return jsonify({
            "ok": False,
            "error": "comment not found"
        })

    comment_owner_id = comment["user_id"]
    reel_id = comment["reel_id"]

    # ==========================================
    # CHECK EXISTING LIKE
    # ==========================================
    c.execute("""
        SELECT id
        FROM reel_comment_likes
        WHERE comment_id=?
          AND user_id=?
    """, (id, uid))

    existing = c.fetchone()

    # ==========================================
    # ❤️ UNLIKE
    # ==========================================
    if existing:

        c.execute("""
            DELETE FROM reel_comment_likes
            WHERE comment_id=?
              AND user_id=?
        """, (id, uid))

        liked = False

    # ==========================================
    # ❤️ LIKE
    # ==========================================
    else:

        c.execute("""
            INSERT OR IGNORE INTO reel_comment_likes
            (
                comment_id,
                user_id
            )
            VALUES (?,?)
        """, (id, uid))

        liked = True

        # ======================================
        # 🔔 COMMENT LIKE NOTIFICATION
        # ======================================

        # Khud ke comment ko like kare
        # to notification nahi jayegi
        if comment_owner_id != uid:

            import json

            meta = {
                "reel_id": reel_id,
                "comment_id": id
            }

            # notifications table already exists
            c.execute("""
                INSERT INTO notifications
                (
                    user_id,
                    actor_id,
                    type,
                    meta
                )
                VALUES (?,?,?,?)
            """, (
                comment_owner_id,
                uid,
                "reel_comment_like",
                json.dumps(meta)
            ))

    # ==========================================
    # GET TOTAL LIKES
    # ==========================================
    c.execute("""
        SELECT COUNT(*) AS total
        FROM reel_comment_likes
        WHERE comment_id=?
    """, (id,))

    row = c.fetchone()

    likes = row["total"] if row else 0

    conn.commit()
    conn.close()

    return jsonify({
        "ok": True,
        "liked": liked,
        "likes": likes
    })

# =========================
#   user id
# =========================
@reels_bp.route("/follow/<int:user_id>", methods=["POST"])
def follow_user(user_id):
    uid = session.get("user_id")
    if not uid:
        return jsonify({"ok": False})

    conn = get_conn()
    c = conn.cursor()

    c.execute("SELECT id FROM follows WHERE follower_id=? AND following_id=?", (uid, user_id))
    row = c.fetchone()

    if row:
        c.execute("DELETE FROM follows WHERE follower_id=? AND following_id=?", (uid, user_id))
        following = False
    else:
        c.execute("INSERT INTO follows (follower_id, following_id) VALUES (?,?)", (uid, user_id))
        following = True

    conn.commit()
    conn.close()

    return jsonify({"ok": True, "following": following})

# =========================
# FOLLOWING USERS LIST FIX
# =========================
@reels_bp.route("/api/following_users")
def reels_following_users():

    uid = session.get("user_id")
    if not uid:
        return jsonify({"users": []})

    conn = get_conn()
    c = conn.cursor()

    c.execute("""
        SELECT u.id, u.username, u.photo
        FROM follows f
        JOIN users u ON u.id = f.following_id
        WHERE f.follower_id=?
    """, (uid,))

    users = []

    for r in c.fetchall():

        photo = r["photo"]

        if not photo or str(photo).lower() in ["none", "null", ""]:
            avatar = "/static/default_dp.png"
        elif str(photo).startswith("http"):
            avatar = photo
        elif str(photo).startswith("/static/"):
            avatar = photo
        else:
            avatar = "/static/profile/" + photo

        users.append({
            "id": r["id"],
            "username": r["username"],
            "avatar": avatar
        })

    conn.close()

    return jsonify({"users": users})

# =========================
# 🎬 SHARE REEL TO USER (DM)
# =========================
@reels_bp.route("/share_to_user/<int:reel_id>/<int:user_id>", methods=["POST"])
def share_to_user(reel_id, user_id):

    sender = session.get("user_id")

    if not sender:
        return jsonify({
            "ok": False,
            "error": "login required"
        }), 401

    # Khud ko reel share nahi
    if sender == user_id:
        return jsonify({
            "ok": False,
            "error": "cannot share to yourself"
        }), 400

    conn = get_conn()
    c = conn.cursor()

    # =========================
    # 🎬 CHECK REEL
    # =========================
    c.execute("""
        SELECT id
        FROM reels
        WHERE id=?
    """, (reel_id,))

    reel = c.fetchone()

    if not reel:
        conn.close()
        return jsonify({
            "ok": False,
            "error": "reel not found"
        }), 404

    # =========================
    # 👤 CHECK USER
    # =========================
    c.execute("""
        SELECT id
        FROM users
        WHERE id=?
    """, (user_id,))

    receiver = c.fetchone()

    if not receiver:
        conn.close()
        return jsonify({
            "ok": False,
            "error": "user not found"
        }), 404

    # =========================
    # 💬 FIND EXISTING CHAT
    # =========================
    c.execute("""
        SELECT id
        FROM chats
        WHERE
            (user1=? AND user2=?)
            OR
            (user1=? AND user2=?)
        LIMIT 1
    """, (
        sender,
        user_id,
        user_id,
        sender
    ))

    chat = c.fetchone()

    # =========================
    # 🆕 CREATE CHAT IF NEEDED
    # =========================
    if chat:
        chat_id = chat["id"]
    else:
        c.execute("""
            INSERT INTO chats(user1, user2)
            VALUES(?, ?)
        """, (
            sender,
            user_id
        ))

        chat_id = c.lastrowid

    # =========================
    # 📌 SPECIAL REEL MESSAGE
    # =========================
    reel_msg = f"__SHARED_REEL__:{reel_id}"

    # =========================
    # 💬 INSERT INTO MESSAGES
    # =========================
    c.execute("""
        INSERT INTO messages
        (
            chat_id,
            sender_id,
            msg,
            attachment,
            created_at
        )
        VALUES (?, ?, ?, ?, datetime('now'))
    """, (
        chat_id,
        sender,
        reel_msg,
        None
    ))

    # =========================
    # 📊 SHARE RECORD
    # =========================
    c.execute("""
        CREATE TABLE IF NOT EXISTS reel_shares (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sender_id INTEGER,
            receiver_id INTEGER,
            reel_id INTEGER,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        )
    """)

    c.execute("""
        INSERT INTO reel_shares
        (
            sender_id,
            receiver_id,
            reel_id
        )
        VALUES (?, ?, ?)
    """, (
        sender,
        user_id,
        reel_id
    ))

    # =========================
    # 📈 SHARE COUNT
    # =========================
    c.execute("""
        UPDATE reels
        SET shares = shares + 1
        WHERE id=?
    """, (reel_id,))

    conn.commit()
    conn.close()

    return jsonify({
        "ok": True,
        "chat_id": chat_id,
        "reel_id": reel_id
    })

############### reels view ##################
@reels_bp.route("/view/<int:reel_id>", methods=["POST"])
def add_view(reel_id):

    uid = session.get("user_id")
    if not uid:
        return jsonify({"ok": False})

    conn = get_conn()
    c = conn.cursor()

    c.execute(
        "SELECT 1 FROM reel_views WHERE reel_id=? AND user_id=?",
        (reel_id, uid)
    )

    if not c.fetchone():

        c.execute(
            "INSERT INTO reel_views (reel_id, user_id) VALUES (?, ?)",
            (reel_id, uid)
        )

        c.execute(
            "UPDATE reels SET views = views + 1 WHERE id=?",
            (reel_id,)
        )

        conn.commit()

    c.execute("SELECT views FROM reels WHERE id=?", (reel_id,))
    views = c.fetchone()["views"]

    conn.close()

    return jsonify({
        "ok": True,
        "views": views
    })
# =========================
# 🎬 SHARED REEL THUMBNAIL
# =========================
@reels_bp.route("/shared_reel/<int:reel_id>")
def shared_reel(reel_id):

    conn = get_conn()
    c = conn.cursor()

    c.execute("""
        SELECT thumbnail
        FROM reels
        WHERE id=?
    """, (reel_id,))

    reel = c.fetchone()

    conn.close()

    if not reel:
        return jsonify({
            "ok": False
        }), 404

    thumbnail = reel["thumbnail"]

    if not thumbnail:
        return jsonify({
            "ok": True,
            "image": "/static/default_post.png"
        })

    # Tumhare upload system ke hisaab se thumbnail
    image = "/static/uploads/reels/thumbs/" + str(thumbnail)

    return jsonify({
        "ok": True,
        "image": image
    })
