import os
import uuid
import sqlite3
import subprocess
from datetime import datetime
from flask import Blueprint, render_template, request, session, redirect, jsonify

reels_bp = Blueprint("reels", __name__, url_prefix="/reels")

DB_NAME = "database.db"

UPLOAD_FOLDER = "static/uploads/reels"
os.makedirs(UPLOAD_FOLDER, exist_ok=True)

THUMB_FOLDER = "static/uploads/reels/thumbs"
os.makedirs(THUMB_FOLDER, exist_ok=True)

ALLOWED_VIDEO_EXT = {"mp4", "webm", "mov", "mkv"}
ALLOWED_IMAGE_EXT = {"jpg", "jpeg", "png", "webp"}

# ===============================
# ✅ DB CONNECTION
# ===============================
def get_conn():
    conn = sqlite3.connect("database.db", timeout=20)
    conn.row_factory = sqlite3.Row
    return conn


# ===============================
# ✅ DB INIT + AUTO UPGRADE
# ===============================
def init_reels_db():
    conn = get_conn()
    c = conn.cursor()

    # reels table
    c.execute("""
        CREATE TABLE IF NOT EXISTS reels (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            caption TEXT,
            video_path TEXT,
            likes INTEGER DEFAULT 0,
            saves INTEGER DEFAULT 0,
            shares INTEGER DEFAULT 0,
            comments_count INTEGER DEFAULT 0,
            views INTEGER DEFAULT 0,
            created_at TEXT
        )
    """)

    # likes table
    c.execute("""
        CREATE TABLE IF NOT EXISTS reel_likes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            reel_id INTEGER,
            user_id INTEGER,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP,
            UNIQUE(reel_id, user_id)
        )
    """)

    # views table
    c.execute("""
    CREATE TABLE IF NOT EXISTS reel_views (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        reel_id INTEGER,
        user_id INTEGER,
        created_at TEXT DEFAULT CURRENT_TIMESTAMP,
        UNIQUE(reel_id, user_id)
    )
    """)

    # comments table
    c.execute("""
        CREATE TABLE IF NOT EXISTS reel_comments (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            reel_id INTEGER,
            user_id INTEGER,
            comment TEXT,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        )
    """)

    # ===============================
    # 💬 COMMENT REPLY SUPPORT
    # ===============================
    c.execute("PRAGMA table_info(reel_comments)")
    comment_cols = [r["name"] for r in c.fetchall()]

    if "parent_id" not in comment_cols:
        c.execute("""
            ALTER TABLE reel_comments
            ADD COLUMN parent_id INTEGER DEFAULT NULL
        """)

    conn.commit()

    # ===============================
    # ❤️ REEL COMMENT LIKES TABLE
    # ===============================
    c.execute("""
        CREATE TABLE IF NOT EXISTS reel_comment_likes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            comment_id INTEGER NOT NULL,
            user_id INTEGER NOT NULL,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP,
            UNIQUE(comment_id, user_id)
        )
    """)

    # =========================
# FOLLOW SYSTEM TABLE
# =========================
    c.execute("""
    CREATE TABLE IF NOT EXISTS follows (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        follower_id INTEGER,
        following_id INTEGER,
        created_at TEXT DEFAULT CURRENT_TIMESTAMP,
        UNIQUE(follower_id, following_id)
    )
    """)   
    # saves table
    c.execute("""
        CREATE TABLE IF NOT EXISTS reel_saves (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            reel_id INTEGER,
            user_id INTEGER,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP,
            UNIQUE(reel_id, user_id)
        )
    """)

    conn.commit()

    # ===============================
    # AUTO ADD MISSING COLUMNS (SAFE)
    # ===============================
    c.execute("PRAGMA table_info(reels)")
    cols = [r["name"] for r in c.fetchall()]

    if "created_at" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN created_at TEXT")
    if "saves" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN saves INTEGER DEFAULT 0")
    if "shares" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN shares INTEGER DEFAULT 0")
    if "comments_count" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN comments_count INTEGER DEFAULT 0")
    if "views" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN views INTEGER DEFAULT 0")
    if "audio_name" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN audio_name TEXT DEFAULT 'Original Audio'")
    if "music_id" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN music_id INTEGER")
    if "music_start" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN music_start REAL DEFAULT 0")
    if "music_end" not in cols:
        c.execute("ALTER TABLE reels ADD COLUMN music_end REAL DEFAULT 0")

    conn.commit()
    conn.close()

# ===============================
# 🎙️ ORIGINAL AUDIO EXTRACTION
# ===============================
ORIGINAL_AUDIO_DIR = "static/uploads/original_audio"
os.makedirs(ORIGINAL_AUDIO_DIR, exist_ok=True)


def extract_reel_original_audio(video_path, user_id, reel_id):
    audio_filename = f"{uuid.uuid4().hex}_original.m4a"
    audio_path = os.path.join(
        ORIGINAL_AUDIO_DIR,
        audio_filename
    )

    try:
        command = [
            "ffmpeg",
            "-y",
            "-i", video_path,
            "-vn",
            "-c:a", "aac",
            "-b:a", "128k",
            audio_path
        ]

        result = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )

        if result.returncode != 0:
            print("❌ Reel original audio extraction failed:")
            print(result.stderr.decode(errors="ignore"))
            return None

        if not os.path.exists(audio_path):
            print("❌ Reel audio file was not created")
            return None

        conn = get_conn()
        c = conn.cursor()

        c.execute("""
            INSERT INTO original_audio
            (
                user_id,
                source_type,
                source_media_id,
                audio_file,
                title
            )
            VALUES (?, ?, ?, ?, ?)
        """, (
            user_id,
            "reel",
            reel_id,
            audio_filename,
            f"Original audio by user {user_id}"
        ))

        original_audio_id = c.lastrowid

        c.execute("""
            INSERT INTO media_audio
            (
                media_type,
                media_id,
                music_id,
                original_audio_id,
                start_time,
                end_time,
                original_volume,
                music_volume
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            "reel",
            reel_id,
            None,
            original_audio_id,
            0,
            30,
            100,
            0
        ))

        conn.commit()
        conn.close()

        print(
            "✅ Reel original audio extracted:",
            original_audio_id,
            "for reel:",
            reel_id
        )

        return original_audio_id

    except Exception as e:
        print("❌ Reel original audio error:", e)
        return None


# ===============================
# ✅ CHECK VIDEO EXTENSION
# ===============================
def allowed_video(filename):
    return "." in filename and filename.rsplit(".", 1)[1].lower() in ALLOWED_VIDEO_EXT

def allowed_reel_media(filename):
    if "." not in filename:
        return False

    ext = filename.rsplit(".", 1)[1].lower()

    return ext in ALLOWED_VIDEO_EXT or ext in ALLOWED_IMAGE_EXT

# ===============================
# ✅ GET CURRENT USER ID
# ===============================
def get_user_id():
    return session.get("user_id", 0)


# ===============================
# 🎬 REELS FEED PAGE (INS STYLE)
# ===============================
@reels_bp.route("/")
def reels_page():
    init_reels_db()

    conn = get_conn()
    c = conn.cursor()

    c.execute("""
        SELECT
            reels.id,
            reels.user_id,
            reels.caption,
            reels.video_path,
            reels.thumbnail,
            reels.likes,
            reels.saves,
            reels.shares,
            reels.comments_count,
            reels.views,
            reels.created_at,
            reels.audio_name,

            reels.music_id,
            reels.music_start,
            reels.music_end,

            music.title AS music_title,
            music.artist AS music_artist,
            music.filename AS music_file,
            music.cover AS music_cover,

            users.username,
            users.photo

        FROM reels

        JOIN users
        ON reels.user_id = users.id

        LEFT JOIN music
        ON reels.music_id = music.id

        ORDER BY reels.id DESC
    """)

    reels = []
    for r in c.fetchall():
        created_at = r["created_at"] or ""

        c.execute("""
            SELECT 1
            FROM reel_likes
            WHERE reel_id=? AND user_id=?
        """, (r["id"], get_user_id()))

        liked = c.fetchone() is not None

        c.execute("""
            SELECT 1
            FROM follows
            WHERE follower_id=? AND following_id=?
        """, (get_user_id(), r["user_id"]))

        is_following = c.fetchone() is not None

        c.execute("""
            SELECT 1
            FROM reel_saves
            WHERE reel_id=? AND user_id=?
        """, (r["id"], get_user_id()))

        saved = c.fetchone() is not None

        c.execute(
            """
            SELECT oa.id, oa.audio_file
            FROM media_audio ma
            JOIN original_audio oa
              ON oa.id = ma.original_audio_id
            WHERE ma.media_type='reel'
              AND ma.media_id=?
              AND ma.original_audio_id IS NOT NULL
            ORDER BY ma.id DESC
            LIMIT 1
            """,
            (r["id"],)
        )

        original_audio = c.fetchone()

        reels.append({
                    "id": r["id"],
                    "user_id": r["user_id"],
                    "username": r["username"],
                    "profile_photo": r["photo"],
                    "caption": r["caption"] or "",
                    "video_path": r["video_path"],
                    "thumbnail": r["thumbnail"],
                    "likes": r["likes"],
                    "liked": liked,
                    "following": is_following,
                    "saves": r["saves"],
                    "saved": saved,
                    "shares": r["shares"],
                    "comments_count": r["comments_count"],
                    "views": r["views"],

                    "created_at": created_at,
                    "audio_name": r["audio_name"],

                    "music_id": r["music_id"],
                    "music_start": r["music_start"],
                    "music_end": r["music_end"],

                    "music_title": r["music_title"],
                    "music_artist": r["music_artist"],
                    "music_file": r["music_file"],
                    "music_cover": r["music_cover"],
                    "original_audio_id": original_audio["id"] if original_audio else None,
                    "original_audio_file": original_audio["audio_file"] if original_audio else None
                })


    uid = get_user_id()

    conn = get_conn()
    c = conn.cursor()

    c.execute("SELECT photo FROM users WHERE id=?", (uid,))
    user = c.fetchone()

    current_user_photo = "/static/default_dp.png"

    if user and user["photo"]:
        current_user_photo = user["photo"]

    conn.close()

    return render_template(
        "reels_feed.html",
        reels=reels,
        current_user=uid,
        current_user_photo=current_user_photo
    )

# ===============================
# 🎬 VIEW REELS OF SAME USER
# ===============================
@reels_bp.route("/<int:reel_id>")
def view_reel(reel_id):

    init_reels_db()

    conn = get_conn()
    c = conn.cursor()

    # Clicked reel owner
    c.execute(
        "SELECT user_id FROM reels WHERE id=?",
        (reel_id,)
    )

    row = c.fetchone()

    if not row:
        conn.close()
        return "Reel not found", 404

    owner_id = row["user_id"]

    # Load only this user's reels
    c.execute("""
        SELECT
            reels.id,
            reels.user_id,
            reels.caption,
            reels.video_path,
            reels.thumbnail,
            reels.likes,
            reels.saves,
            reels.shares,
            reels.comments_count,
            reels.views,
            reels.created_at,
            reels.audio_name,

            reels.music_id,
            reels.music_start,
            reels.music_end,

            music.title AS music_title,
            music.artist AS music_artist,
            music.filename AS music_file,
            music.cover AS music_cover,

            users.username,
            users.photo

        FROM reels

        JOIN users
            ON reels.user_id = users.id

        LEFT JOIN music
            ON reels.music_id = music.id

        WHERE reels.user_id=?

        ORDER BY
            CASE WHEN reels.id=? THEN 0 ELSE 1 END,
            reels.id DESC
    """, (owner_id, reel_id))

    reels = []

    for r in c.fetchall():

        c.execute(
            "SELECT 1 FROM reel_likes WHERE reel_id=? AND user_id=?",
            (r["id"], get_user_id())
        )

        liked = c.fetchone() is not None

        c.execute(
            "SELECT 1 FROM follows WHERE follower_id=? AND following_id=?",
            (get_user_id(), r["user_id"])
        )

        following = c.fetchone() is not None

        c.execute(
            "SELECT 1 FROM reel_saves WHERE reel_id=? AND user_id=?",
            (r["id"], get_user_id())
        )

        saved = c.fetchone() is not None

        c.execute(
            """
            SELECT oa.id, oa.audio_file
            FROM media_audio ma
            JOIN original_audio oa
              ON oa.id = ma.original_audio_id
            WHERE ma.media_type='reel'
              AND ma.media_id=?
              AND ma.original_audio_id IS NOT NULL
            ORDER BY ma.id DESC
            LIMIT 1
            """,
            (r["id"],)
        )

        original_audio = c.fetchone()

        reels.append({
            "id": r["id"],
            "user_id": r["user_id"],
            "username": r["username"],
            "profile_photo": r["photo"],
            "caption": r["caption"] or "",
            "video_path": r["video_path"],
            "thumbnail": r["thumbnail"],
            "likes": r["likes"],
            "liked": liked,
            "following": following,
            "saves": r["saves"],
            "saved": saved,
            "shares": r["shares"],
            "comments_count": r["comments_count"],
            "views": r["views"],
            "created_at": r["created_at"],
            "audio_name": r["audio_name"],
            "music_id": r["music_id"],
            "music_start": r["music_start"],
            "music_end": r["music_end"],
            "music_title": r["music_title"],
            "music_artist": r["music_artist"],
            "music_file": r["music_file"],
            "music_cover": r["music_cover"],
            "original_audio_id": original_audio["id"] if original_audio else None,
            "original_audio_file": original_audio["audio_file"] if original_audio else None
        })

    uid = get_user_id()

    current_user_photo = "/static/default_dp.png"

    c.execute(
        "SELECT photo FROM users WHERE id=?",
        (uid,)
    )

    user = c.fetchone()

    if user and user["photo"]:
        current_user_photo = user["photo"]

    conn.close()

    return render_template(
        "reels_feed.html",
        reels=reels,
        current_user=uid,
        current_user_photo=current_user_photo
    )

# ===============================
# ⬆️ UPLOAD REEL
# ===============================
@reels_bp.route("/upload", methods=["GET", "POST"])
def upload_reel():
    init_reels_db()

    if "user_id" not in session:
        return redirect("/auth/login")

    if request.method == "GET":
        return render_template("reels_upload.html")

    caption = request.form.get("caption", "").strip()
    file = request.files.get("video")

    if not file or file.filename == "":
        return "No video selected", 400

    if not allowed_video(file.filename):
        return "Invalid video format", 400

    ext = file.filename.rsplit(".", 1)[-1].lower()
    new_name = f"{uuid.uuid4().hex}.{ext}"

    save_path = os.path.join(UPLOAD_FOLDER, new_name)
    file.save(save_path)

    # AUTO THUMBNAIL
    thumb_name = f"{uuid.uuid4().hex}.jpg"
    thumb_path = os.path.join(THUMB_FOLDER, thumb_name)

    os.system(
        f'ffmpeg -i "{save_path}" -ss 00:00:01 -vframes 1 "{thumb_path}" -y'
    )


    uid = get_user_id()

    conn = get_conn()
    c = conn.cursor()

    c.execute("""
        INSERT INTO reels
        (
            user_id,
            caption,
            video_path,
            thumbnail,
            audio_name,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        uid,
        caption,
        new_name,
        thumb_name,
        "Original Audio",
        datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ))

    reel_id = c.lastrowid

    conn.commit()

    # ===============================
    # 🎙️ EXTRACT ORIGINAL AUDIO
    # ===============================
    original_audio_id = None

    if ext in {"mp4", "webm", "mov", "mkv"}:
        original_audio_id = extract_reel_original_audio(
            save_path,
            uid,
            reel_id
        )

    conn.close()

    return redirect("/reels")

# ===============================
# ❤️ LIKE / UNLIKE REEL (AJAX)
# ===============================
@reels_bp.route("/like_toggle/<int:reel_id>", methods=["POST"])
def like_toggle(reel_id):
    init_reels_db()

    if "user_id" not in session:
        return jsonify({"ok": False, "error": "login required"}), 401

    uid = get_user_id()

    conn = get_conn()
    c = conn.cursor()

    # ==========================================
    # 🎬 CHECK REEL + OWNER
    # ==========================================
    c.execute("""
        SELECT id, user_id, likes
        FROM reels
        WHERE id=?
    """, (reel_id,))

    reel = c.fetchone()

    if not reel:
        conn.close()
        return jsonify({
            "ok": False,
            "error": "reel not found"
        }), 404

    reel_owner_id = reel["user_id"]

    # ==========================================
    # ❤️ CHECK EXISTING LIKE
    # ==========================================
    c.execute("""
        SELECT id
        FROM reel_likes
        WHERE reel_id=? AND user_id=?
    """, (reel_id, uid))

    liked = c.fetchone()

    # ==========================================
    # 💔 UNLIKE
    # ==========================================
    if liked:

        c.execute("""
            DELETE FROM reel_likes
            WHERE reel_id=? AND user_id=?
        """, (reel_id, uid))

        c.execute("""
            UPDATE reels
            SET likes = CASE
                WHEN likes > 0 THEN likes - 1
                ELSE 0
            END
            WHERE id=?
        """, (reel_id,))

        new_state = False

    # ==========================================
    # ❤️ LIKE
    # ==========================================
    else:

        c.execute("""
            INSERT OR IGNORE INTO reel_likes
            (reel_id, user_id)
            VALUES (?,?)
        """, (reel_id, uid))

        c.execute("""
            UPDATE reels
            SET likes = likes + 1
            WHERE id=?
        """, (reel_id,))

        new_state = True

        # ======================================
        # 🔔 REEL LIKE NOTIFICATION
        # ======================================

        # Khud ki Reel ko like kare to notification nahi
        if reel_owner_id != uid:

            import json

            meta = {
                "reel_id": reel_id
            }

            c.execute("""
                INSERT INTO notifications
                (
                    user_id,
                    actor_id,
                    type,
                    meta
                )
                VALUES (?,?,?,?)
            """, (
                reel_owner_id,
                uid,
                "reel_like",
                json.dumps(meta)
            ))

    # ==========================================
    # ❤️ GET UPDATED LIKE COUNT
    # ==========================================
    c.execute("""
        SELECT likes
        FROM reels
        WHERE id=?
    """, (reel_id,))

    row = c.fetchone()
    count = row["likes"] if row else 0

    conn.commit()
    conn.close()

    return jsonify({
        "ok": True,
        "liked": new_state,
        "count": count
    })

# ===============================
# 🔖 SAVE / UNSAVE REEL (AJAX)
# ===============================
@reels_bp.route("/save_toggle/<int:reel_id>", methods=["POST"])
def save_toggle(reel_id):

    uid = session.get("user_id")

    if not uid:
        return jsonify({"ok": False})

    conn = get_conn()
    c = conn.cursor()

    c.execute(
        "SELECT id FROM reel_saves WHERE user_id=? AND reel_id=?",
        (uid, reel_id)
    )

    exists = c.fetchone()

    if exists:

        c.execute(
            "DELETE FROM reel_saves WHERE user_id=? AND reel_id=?",
            (uid, reel_id)
        )

        c.execute(
            "UPDATE reels SET saves = CASE WHEN saves > 0 THEN saves - 1 ELSE 0 END WHERE id=?",
            (reel_id,)
        )

        saved = False

    else:

        c.execute(
            "INSERT INTO reel_saves (user_id,reel_id) VALUES (?,?)",
            (uid, reel_id)
        )

        c.execute(
            "UPDATE reels SET saves=saves+1 WHERE id=?",
            (reel_id,)
        )

        saved = True

    conn.commit()

    c.execute(
        "SELECT saves FROM reels WHERE id=?",
        (reel_id,)
    )

    count = c.fetchone()["saves"]

    conn.close()

    return jsonify({
        "ok": True,
        "saved": saved,
        "count": count
    })

# ===============================
# 📤 SHARE REEL (COUNT)
# ===============================
@reels_bp.route("/share/<int:reel_id>", methods=["POST"])
def share_reel(reel_id):
    init_reels_db()

    conn = get_conn()
    c = conn.cursor()

    c.execute("UPDATE reels SET shares = shares + 1 WHERE id=?", (reel_id,))
    conn.commit()

    c.execute("SELECT shares FROM reels WHERE id=?", (reel_id,))
    shares = c.fetchone()["shares"]

    conn.close()

    return jsonify({"ok": True, "shares": shares})

# ===============================
# 💬 ADD COMMENT / REPLY (AJAX)
# ===============================
@reels_bp.route("/comment/<int:reel_id>", methods=["POST"])
def add_comment(reel_id):

    init_reels_db()

    if "user_id" not in session:
        return jsonify({
            "ok": False,
            "error": "login required"
        })

    uid = get_user_id()

    comment = request.form.get("comment", "").strip()
    reply_to = request.form.get("reply_to", "").strip()

    if not comment:
        return jsonify({
            "ok": False,
            "error": "empty comment"
        })

    parent_id = None
    parent_owner_id = None

    conn = get_conn()
    c = conn.cursor()

    # ===============================
    # 🎬 CHECK REEL
    # ===============================
    c.execute("""
        SELECT id, user_id
        FROM reels
        WHERE id=?
    """, (reel_id,))

    reel = c.fetchone()

    if not reel:
        conn.close()
        return jsonify({
            "ok": False,
            "error": "reel not found"
        })

    reel_owner_id = reel["user_id"]

    # ===============================
    # 🔁 CHECK REPLY TARGET
    # ===============================
    if reply_to:

        try:
            reply_to = int(reply_to)
        except (ValueError, TypeError):
            reply_to = None

        if reply_to:

            c.execute("""
                SELECT id, user_id
                FROM reel_comments
                WHERE id=?
                  AND reel_id=?
                  AND parent_id IS NULL
            """, (reply_to, reel_id))

            parent = c.fetchone()

            if parent:
                parent_id = parent["id"]
                parent_owner_id = parent["user_id"]

    # ===============================
    # 💬 SAVE COMMENT / REPLY
    # ===============================
    c.execute("""
        INSERT INTO reel_comments
        (
            reel_id,
            user_id,
            comment,
            parent_id
        )
        VALUES (?,?,?,?)
    """, (
        reel_id,
        uid,
        comment,
        parent_id
    ))

    new_comment_id = c.lastrowid

    # ===============================
    # 📈 UPDATE COMMENT COUNT
    # ===============================
    c.execute("""
        UPDATE reels
        SET comments_count = comments_count + 1
        WHERE id=?
    """, (reel_id,))

    # ===============================
    # 🔔 NOTIFICATION
    # ===============================

    # REPLY
    if parent_id is not None:

        # Reply ki notification main comment ke owner ko
        # Khud ko notification nahi bhejni
        if parent_owner_id and parent_owner_id != uid:

            meta = {
                "reel_id": reel_id,
                "comment_id": new_comment_id,
                "parent_id": parent_id
            }

            import json

            c.execute("""
                INSERT INTO notifications
                (
                    user_id,
                    actor_id,
                    type,
                    meta
                )
                VALUES (?,?,?,?)
            """, (
                parent_owner_id,
                uid,
                "reel_reply",
                json.dumps(meta)
            ))

    # NORMAL COMMENT
    else:

        # Reel owner ko notification
        # Khud apni reel par comment kare to notification nahi
        if reel_owner_id != uid:

            meta = {
                "reel_id": reel_id,
                "comment_id": new_comment_id
            }

            import json

            c.execute("""
                INSERT INTO notifications
                (
                    user_id,
                    actor_id,
                    type,
                    meta
                )
                VALUES (?,?,?,?)
            """, (
                reel_owner_id,
                uid,
                "reel_comment",
                json.dumps(meta)
            ))

    conn.commit()
    conn.close()

    return jsonify({
        "ok": True,
        "reply": parent_id is not None
    })

# ===============================
# 💬 GET COMMENTS + REPLIES (AJAX)
# ===============================
@reels_bp.route("/comments/<int:reel_id>")
def get_comments(reel_id):

    init_reels_db()

    uid = session.get("user_id", 0)

    conn = get_conn()
    c = conn.cursor()

    # ==========================================
    # LOAD ALL COMMENTS + REPLIES
    # ==========================================
    c.execute("""
        SELECT
            rc.id,
            rc.reel_id,
            rc.user_id,
            rc.comment,
            rc.created_at,
            rc.parent_id,

            u.username,
            u.photo,

            (
                SELECT COUNT(*)
                FROM reel_comment_likes rcl
                WHERE rcl.comment_id = rc.id
            ) AS likes,

            EXISTS(
                SELECT 1
                FROM reel_comment_likes rcl2
                WHERE rcl2.comment_id = rc.id
                  AND rcl2.user_id = ?
            ) AS liked

        FROM reel_comments rc

        JOIN users u
            ON rc.user_id = u.id

        WHERE rc.reel_id = ?

        ORDER BY rc.id ASC
    """, (uid, reel_id))

    rows = c.fetchall()

    # ==========================================
    # CREATE ALL COMMENT OBJECTS
    # ==========================================
    all_comments = {}

    for r in rows:

        all_comments[r["id"]] = {
            "id": r["id"],
            "username": r["username"],
            "user_id": r["user_id"],
            "text": r["comment"],
            "profile": r["photo"],
            "likes": r["likes"] or 0,
            "liked": bool(r["liked"]),
            "parent_id": r["parent_id"],
            "replies": []
        }

    # ==========================================
    # SEPARATE COMMENTS + REPLIES
    # ==========================================
    comments = []

    for r in rows:

        current = all_comments[r["id"]]

        # ===============================
        # MAIN COMMENT
        # ===============================
        if r["parent_id"] is None:

            comments.append(current)

        # ===============================
        # REPLY
        # ===============================
        else:

            parent = all_comments.get(r["parent_id"])

            if parent:
                parent["replies"].append(current)

    conn.close()

    # ==========================================
    # NEWEST MAIN COMMENTS FIRST
    # ==========================================
    comments.reverse()

    return jsonify({
        "ok": True,
        "comments": comments
    })


# ===============================
# 🗑 DELETE COMMENT (OWNER ONLY)
# ===============================
@reels_bp.route("/comment_delete/<int:comment_id>", methods=["POST"])
def delete_comment(comment_id):
    init_reels_db()

    if "user_id" not in session:
        return jsonify({"ok": False, "error": "login required"})

    uid = get_user_id()

    conn = get_conn()
    c = conn.cursor()

    c.execute("SELECT reel_id, user_id FROM reel_comments WHERE id=?", (comment_id,))
    row = c.fetchone()

    if not row:
        conn.close()
        return jsonify({"ok": False, "error": "not found"})

    reel_id = row["reel_id"]
    owner_id = row["user_id"]

    if owner_id != uid:
        conn.close()
        return jsonify({"ok": False, "error": "not allowed"})

    c.execute("DELETE FROM reel_comments WHERE id=?", (comment_id,))
    c.execute("UPDATE reels SET comments_count = comments_count - 1 WHERE id=? AND comments_count > 0", (reel_id,))

    conn.commit()
    conn.close()

    return jsonify({"ok": True})


# ===============================
# 🗑 DELETE REEL (ONLY OWNER)
# ===============================
@reels_bp.route("/delete/<int:reel_id>", methods=["POST"])
def delete_reel(reel_id):
    init_reels_db()

    if "user_id" not in session:
        return redirect("/auth/login")

    uid = get_user_id()

    conn = get_conn()
    c = conn.cursor()

    c.execute("SELECT video_path, user_id FROM reels WHERE id=?", (reel_id,))
    row = c.fetchone()

    if not row:
        conn.close()
        return redirect("/reels")

    video_path = row["video_path"]
    owner_id = row["user_id"]

    if owner_id != uid:
        conn.close()
        return redirect("/reels")

    try:
        os.remove(os.path.join(UPLOAD_FOLDER, video_path))
    except:
        pass

    c.execute("DELETE FROM reel_likes WHERE reel_id=?", (reel_id,))
    c.execute("DELETE FROM reel_comments WHERE reel_id=?", (reel_id,))
    c.execute("DELETE FROM reel_saves WHERE reel_id=?", (reel_id,))
    c.execute("DELETE FROM reels WHERE id=?", (reel_id,))

    conn.commit()
    conn.close()

    return redirect("/reels")

